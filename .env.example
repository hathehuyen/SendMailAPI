# Copy to .env and adjust for your environment.
# Every value below is read by sendmail_api/config.py at start-up.

# --- HTTP -------------------------------------------------------------------
MAX_CONTENT_LENGTH=1048576
MAX_MESSAGE_LENGTH=10000

# --- Authentication (required) ----------------------------------------------
SEND_API_KEY=change-me-to-a-long-random-string

# --- Message headers (required) ---------------------------------------------
SUBJECT=System Email
FROM=noreply@example.com
RCPT_TO=ops@example.com,oncall@example.com

# --- SMTP transport ---------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_TIMEOUT=10
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=false
SMTP_USE_SSL=false

# --- Audit database ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=maillog
DB_PASSWORD=
DB_NAME=maillog
DB_TIMEOUT=10

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
